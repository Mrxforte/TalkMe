rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated and is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollection for learned vocabulary items
      match /learned_words/{wordId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection for mastered grammar rules
      match /mastered_rules/{ruleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
