    <string name="grammar_catalog_tag">GRAMMATIKA · BATAFSIL KATALOG</string>
    <string name="grammar_catalog_heading">Grammar — batafsil grammatika katalogi</string>
    <string name="grammar_catalog_desc">Quyidagi 23 modul ingliz grammatikasining asosiy va ko\'plab yuqori darajadagi bo\'limlarini qamrab oladi. Har bir bullet kichik mavzular guruhidir; ishlab chiqishda uni zarur bo\'lsa alohida darslarga ajrating.</string>
    <string name="module_1_tag">MODUL 1</string>
    <string name="module_1_count">5 kichik mavzu</string>
    <string name="module_1_title">Grammar fundamentals</string>
    <string name="module_1_bullet_1">Alphabet and letter names; vowels and consonants; phonics and spelling basics.</string>
    <string name="module_1_bullet_2">Parts of speech; word, phrase, clause and sentence; subject, verb, object and complement.</string>
    <string name="module_1_bullet_3">Basic word order (SVO); affirmative, negative and interrogative sentences; imperatives.</string>
    <string name="module_1_bullet_4">There is / There are; it is / this is / that is; singular and plural nouns.</string>
    <string name="module_1_bullet_5">Capitalization, punctuation, contractions and sentence boundaries.</string>
    <string name="continue_grammar_catalog_btn">Grammatika katalogini davom ettirish</string>
    <string name="catalog_footer_note">Rejada 23 modul. Hozir 1–4-modullar to\'liq, 5-modul esa qisman kiritilgan.</string>

